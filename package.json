{
  "name": "gmoecosystem-app",
  "version": "1.0.0",
  "private": true,
  "description": "GMO Ecosystem — Ionic React app (English + Spanish)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "node scripts/check-i18n.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/core": "^7.0.0",
    "@ionic/react": "^8.8.0",
    "@ionic/react-router": "^8.8.0",
    "ionicons": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
